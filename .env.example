# Dinner Tab — copy to `.env` and fill in. Never commit the real `.env`.

# ------------------------------------------------------------------- core
ENV=development                 # production on the server (Secure cookies; needs HTTPS)
LOG_LEVEL=INFO
# python -c "import secrets; print(secrets.token_urlsafe(48))"
# Signs cookies and encrypts the Up webhook secret. Changing it signs everyone
# out and means re-registering the Up webhook.
SECRET_KEY=change-me
# Organiser password (12+ characters in production). Rate limited: 5 tries / 5 min.
ADMIN_PASSWORD=

DATABASE_URL=sqlite:///./data/dinnertab.db
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=15

# SERVER: just the hostname, e.g. dinner.appfoundry.cc
TRUSTED_HOSTS=*
# SERVER: true (Caddy terminates TLS)
TRUST_PROXY_HEADERS=false
# SERVER: https://dinner.appfoundry.cc — used for the QR code and Up webhook URL
PUBLIC_BASE_URL=

# ------------------------------------------------ menu & receipt reading
# From https://console.anthropic.com. Blank = type menus in by hand
# (the demo's sample photos still work).
ANTHROPIC_API_KEY=
EXTRACTION_MODEL=claude-opus-5-5
EXTRACTION_EFFORT=high

# ---------------------------------------------------------------- Up Bank
# Up app -> Data sharing -> Personal Access Token. Server only; never in a page.
# Blank = no automatic detection; mark payments received by hand.
UP_API_TOKEN=
UP_POLL_MINUTES=5
PAYMENT_WINDOW_DAYS=30

# "Simulate a payment" on demo dinners (never touches a bank).
DEMO_TOOLS=true
